-- Menu (with name entry), host discovery and lobby, plus running Secret Word.
-- Networking: net/lobby_net.lua. Game rules (host only): game/secret_word.lua.
-- Game screens: game/screens.lua. Shared GUI helpers and layout units: ui/ui.lua.

local net = require "net.lobby_net"
local ui = require "ui.ui"
local secret_word = require "game.secret_word"
local screens = require "game.screens"

local PAD, CW = ui.PAD, ui.CONTENT_W
local CX = ui.W / 2
local BOTTOM_Y, BUTTON_H = 756, 56
local MAX_NAME_LENGTH = 12
local SAVE_FILE = sys.get_save_file("SecretWordGame", "settings")

local LEFT_MESSAGES = {
	["left"] = "%s left",
	["lost connection"] = "%s lost connection",
	["disconnected"] = "%s disconnected",
}

-- How each editable game setting is shown: popup title/hint, chip text and option text
local function duration(seconds)
	return seconds < 60 and (seconds .. " s") or (math.floor(seconds / 60) .. " min")
end

local SETTING_TEXTS = {
	rounds = {
		title = "Rounds", hint = "How many rounds to play.",
		chip = function(v) return v .. " rounds" end,
		option = function(v) return tostring(v) end,
	},
	clue_time = {
		title = "Time per clue", hint = "How long each player has to give their clue.",
		chip = function(v) return v .. " s per clue" end,
		option = function(v) return v .. " s" end,
	},
	discuss_time = {
		title = "Discussion", hint = "Talk time before voting opens.",
		chip = function(v) return duration(v) .. " discussion" end,
		option = duration,
	},
}

---------------------------------------------------------------------------
-- Player name and host settings (saved between launches, in one file)
---------------------------------------------------------------------------

local function utf8_len(s)
	return #s:gsub("[\128-\191]", "")
end

local function load_saved(self)
	local saved = sys.load(SAVE_FILE)
	if type(saved.name) == "string" and saved.name ~= "" then
		self.name = saved.name
	else
		self.name = "Player " .. math.random(10, 99)
	end
	self.host_settings = secret_word.settings(saved.settings)
end

-- sys.save replaces the whole file, so always write everything
local function persist(self)
	sys.save(SAVE_FILE, { name = self.name, settings = self.host_settings })
end

---------------------------------------------------------------------------
-- Screens
---------------------------------------------------------------------------

local show_menu, show_scan, show_lobby

local function header(self, overline, title, subtitle)
	ui.label(self, overline, PAD, 64, { font = "bold", size = 13, color = ui.ACCENT })
	ui.label(self, title, PAD, 104, { font = "heading", size = 40 })
	if subtitle then
		ui.label(self, subtitle, PAD, 130, { size = 15, color = ui.DIM, width = CW, top = true })
	end
end

local function start_editing(self)
	self.editing = true
	self.draft = self.name
	self.marked = ""
	gui.show_keyboard(gui.KEYBOARD_TYPE_DEFAULT, false)
	show_menu(self, self.message)
end

local function finish_editing(self)
	if not self.editing then
		return
	end
	self.editing = false
	gui.hide_keyboard()
	local name = (self.draft .. (self.marked or "")):match("^%s*(.-)%s*$")
	if name ~= "" then
		self.name = name
		persist(self)
	end
	show_menu(self, self.message)
end

function show_menu(self, message)
	net.stop()
	self.game = nil
	self.popup = nil
	self.screen = "menu"
	self.players = {}
	self.message = message
	ui.set_banner(self, false)
	ui.clear(self)

	header(self, "LOCAL PARTY GAME", "Secret Word", "Everyone in the same room. Talk out loud, vote here.")

	-- Name field
	ui.label(self, "Your name", PAD, 212, { font = "bold", size = 15 })
	local field = ui.rect(self, PAD, 228, CW, 60, { color = ui.SURFACE, radius = 14 })
	ui.rect(self, PAD, 228, CW, 60, { color = self.editing and ui.ACCENT or ui.LINE, radius = 14, outline = true })
	self.name_field = field
	local shown = self.editing and (self.draft .. self.marked .. "|") or self.name
	ui.label(self, shown, PAD + 18, 258, { font = "bold", size = 20 })
	if self.editing then
		ui.link(self, "Done", ui.W - PAD - 16, 258, function() finish_editing(self) end)
		ui.label(self, "Others will see this name in the game.", PAD, 306, { size = 13, color = ui.DIM })
	else
		ui.label(self, "Edit", ui.W - PAD - 16, 258, { font = "bold", size = 14, color = ui.ACCENT, align = "right" })
		ui.on_tap(self, field, function() start_editing(self) end)
	end

	if message then
		ui.label(self, message, CX, 560, { size = 14, color = ui.DANGER, align = "center", width = 320, top = true })
	end

	local ips = net.local_ips()
	if #ips > 0 then
		ui.label(self, "On network " .. table.concat(ips, ", "), CX, 660, { size = 13, color = ui.DIM, align = "center" })
	else
		ui.label(self, "No Wi-Fi or hotspot network found", CX, 660, { size = 13, color = ui.DANGER, align = "center" })
	end

	ui.button(self, "Host a game", PAD, BOTTOM_Y - BUTTON_H - 12, CW, BUTTON_H, function()
		local ok, err = net.host(self.name)
		if ok then
			net.set_settings(self.host_settings)
			show_lobby(self)
		else
			show_menu(self, err)
		end
	end)
	ui.button(self, "Join a game", PAD, BOTTOM_Y, CW, BUTTON_H, function()
		net.scan()
		show_scan(self, {})
	end, { style = "secondary" })
end

function show_scan(self, hosts)
	self.screen = "scan"
	ui.clear(self)

	header(self, "JOIN A GAME", "Find a game", "Looking on your Wi-Fi or hotspot…")

	if #hosts == 0 then
		ui.circle(self, CX, 330, 72, ui.LINE, true)
		ui.circle(self, CX, 330, 16, ui.ACCENT)
		ui.label(self, "Searching for hosts…", CX, 400, { size = 15, color = ui.DIM, align = "center" })
		ui.label(self, "Ask the host to tap “Host a game”.", CX, 426, { size = 13, color = ui.MUTED, align = "center" })
	end

	for i, h in ipairs(hosts) do
		local y = 180 + (i - 1) * 82
		local tile = ui.rect(self, PAD, y, CW, 72, { color = ui.SURFACE, radius = 14 })
		ui.label(self, h.name or h.ip, PAD + 18, y + 26, { font = "bold", size = 17 })
		ui.label(self, ("%d of %d players"):format(h.players or 0, h.max or net.MAX_PLAYERS), PAD + 18, y + 50, { size = 13, color = ui.DIM })
		ui.label(self, "Join", ui.W - PAD - 18, y + 36, { font = "bold", size = 15, color = ui.ACCENT, align = "right" })
		ui.on_tap(self, tile, function()
			local ok, err = net.join(h.ip, h.port, self.name)
			if ok then
				self.settings = nil -- the host sends its settings right after we join
				show_lobby(self)
			else
				show_menu(self, err)
			end
		end)
	end

	ui.button(self, "Back", PAD, BOTTOM_Y, CW, BUTTON_H, function() show_menu(self) end, { style = "secondary" })
end

-- Pill-shaped chips that wrap onto new rows; items: { text, on_tap (optional) }.
-- Tappable chips get an accent outline. Returns the bottom y.
local function chips(self, items, top)
	local x, y = PAD, top
	for _, item in ipairs(items) do
		local n = ui.label(self, item.text, 0, 0, { size = 14 })
		local w = ui.text_width(n) + 28
		gui.delete_node(n)
		table.remove(self.nodes)
		if x + w > ui.W - PAD then
			x, y = PAD, y + 44
		end
		local chip = ui.rect(self, x, y, w, 36, { color = ui.SURFACE, radius = 18 })
		if item.on_tap then
			ui.rect(self, x, y, w, 36, { color = ui.ACCENT, radius = 18, outline = true })
			ui.on_tap(self, chip, item.on_tap)
		end
		ui.label(self, item.text, x + w / 2, y + 18, { size = 14, align = "center" })
		x = x + w + 8
	end
	return y + 36
end

-- Bottom sheet for picking one setting's value (host only)
local function settings_popup(self, key)
	local choice
	for _, c in ipairs(secret_word.CHOICES) do
		if c.key == key then
			choice = c
		end
	end
	local texts = SETTING_TEXTS[key]
	local function close()
		self.popup = nil
		show_lobby(self)
	end

	-- While the popup is open, only it reacts to taps
	self.buttons = {}
	local backdrop = ui.rect(self, 0, 0, ui.W, ui.H, { color = vmath.vector4(0, 0, 0, 0.6) })
	local top = 520
	local sheet = ui.rect(self, 0, top, ui.W, ui.H - top + 40, { color = ui.SURFACE, radius = 28 })
	ui.label(self, texts.title, PAD, top + 44, { font = "heading", size = 26 })
	ui.label(self, texts.hint, PAD, top + 76, { size = 14, color = ui.DIM })

	local n, gap = #choice.options, 8
	local w = (CW - gap * (n - 1)) / n
	for i, option in ipairs(choice.options) do
		local selected = self.host_settings[key] == option
		ui.button(self, texts.option(option), PAD + (i - 1) * (w + gap), top + 104, w, 56, function()
			self.host_settings[key] = option
			self.popup = nil
			persist(self)
			net.set_settings(self.host_settings) -- shows the lobby again via the "settings" event
		end, { style = selected and "primary" or "tile", size = 17 })
	end
	ui.button(self, "Cancel", PAD, BOTTOM_Y, CW, BUTTON_H, close, { style = "secondary" })

	ui.on_tap(self, sheet, function() end) -- taps on the sheet itself don't close it
	ui.on_tap(self, backdrop, close)
end

function show_lobby(self)
	self.game = nil
	self.screen = "lobby"
	ui.clear(self)

	local hosting = net.is_host()
	header(self, hosting and "YOU'RE HOSTING" or "LOCAL GAME", "Secret Word", "Everyone in the same room. Talk out loud, vote here.")
	ui.link(self, "Leave", ui.W - PAD, 64, function() show_menu(self) end)

	ui.label(self, "Players", PAD, 190, { font = "bold", size = 15 })
	ui.label(self, ("%d of %d"):format(#self.players, net.MAX_PLAYERS), ui.W - PAD, 190, { size = 14, color = ui.DIM, align = "right" })

	local me = net.my_id()
	local tile_w, tile_h, gap = (CW - 10) / 2, 58, 10
	for i = 1, net.MAX_PLAYERS do
		local x = PAD + ((i - 1) % 2) * (tile_w + gap)
		local y = 208 + math.floor((i - 1) / 2) * (tile_h + gap)
		local p = self.players[i]
		if p then
			ui.rect(self, x, y, tile_w, tile_h, { color = ui.SURFACE, radius = 14 })
			if p.id == me then
				ui.rect(self, x, y, tile_w, tile_h, { color = ui.ACCENT, radius = 14, outline = true })
			end
			ui.avatar(self, x + 28, y + tile_h / 2, 32, p.color, p.name)
			local tags = {}
			if p.id == me then tags[#tags + 1] = "You" end
			if p.host then tags[#tags + 1] = (#tags > 0 and "host" or "Host") end
			if #tags > 0 then
				ui.label(self, p.name, x + 54, y + 21, { font = "bold", size = 15 })
				ui.label(self, table.concat(tags, " · "), x + 54, y + 40, { size = 12, color = ui.DIM })
			else
				ui.label(self, p.name, x + 54, y + tile_h / 2, { font = "bold", size = 15 })
			end
		else
			ui.rect(self, x, y, tile_w, tile_h, { color = ui.LINE_STRONG, radius = 14, outline = true })
			ui.label(self, "Open seat", x + tile_w / 2, y + tile_h / 2, { size = 14, color = ui.DIM, align = "center" })
		end
	end

	-- Host: its own settings (tap a chip to change). Clients: whatever the host sent.
	local s = hosting and self.host_settings or self.settings or secret_word.settings()
	ui.label(self, "Game settings", PAD, 500, { font = "bold", size = 15 })
	if hosting then
		ui.label(self, "Tap to change", ui.W - PAD, 500, { size = 13, color = ui.DIM, align = "right" })
	end
	local items = {}
	for _, choice in ipairs(secret_word.CHOICES) do
		items[#items + 1] = {
			text = SETTING_TEXTS[choice.key].chip(s[choice.key]),
			on_tap = hosting and function()
				self.popup = choice.key
				show_lobby(self)
			end or nil,
		}
	end
	items[#items + 1] = { text = "1 impostor" }
	chips(self, items, 518)

	if hosting then
		ui.label(self, "Others join from the same Wi-Fi: " .. table.concat(net.local_ips(), ", "), CX, 728, { size = 13, color = ui.DIM, align = "center" })
		local enough = #self.players >= secret_word.MIN_PLAYERS
		ui.button(self, enough and "Start game" or ("Need %d players to start"):format(secret_word.MIN_PLAYERS),
			PAD, BOTTOM_Y, CW, BUTTON_H, function() net.start_game() end, { enabled = enough })
	else
		ui.label(self, "Waiting for the host to start…", CX, BOTTOM_Y + BUTTON_H / 2, { size = 15, color = ui.DIM, align = "center" })
	end

	if hosting and self.popup then
		settings_popup(self, self.popup)
	end
end

---------------------------------------------------------------------------
-- Network events
---------------------------------------------------------------------------

local function on_net(self, event, data)
	if event == "hosts" then
		if self.screen == "scan" then
			show_scan(self, data)
		end
	elseif event == "lobby" then
		self.players = data
		if self.screen == "lobby" then
			show_lobby(self)
		end
	elseif event == "welcome" then
		if self.screen == "lobby" then
			show_lobby(self) -- refresh the "You" tag
		end
	elseif event == "start" then
		-- Only the host runs the rules; everyone (host included) then gets "game" views
		if net.is_host() then
			self.popup = nil
			self.game = secret_word.new(self.players, function(id, view) net.send_to(id, view) end, self.host_settings)
		end
	elseif event == "action" then
		if self.game then
			self.game:on_action(data.from, data.data)
		end
	elseif event == "game" then
		screens.render(self, data)
	elseif event == "to_lobby" then
		show_lobby(self)
	elseif event == "settings" then
		self.settings = secret_word.settings(data)
		if self.screen == "lobby" then
			show_lobby(self)
		end
	elseif event == "player_left" then
		local fmt = LEFT_MESSAGES[data.reason] or "%s left"
		ui.toast(self, fmt:format(data.name), ui.player_color(data.color).fill)
		if self.game then
			self.game:on_player_left(data.id)
		end
	elseif event == "connection" then
		ui.set_banner(self, not data.stable)
	elseif event == "disconnected" then
		show_menu(self, data)
	end
	ui.raise_overlays(self)
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

function init(self)
	ui.init(self)
	self.players = {}
	self.screen = "menu"
	self.editing = false
	self.leave = function() show_menu(self) end -- used by the game screens

	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	load_saved(self)

	ui.init_overlays(self)
	net.set_listener(function(event, data) on_net(self, event, data) end)
	show_menu(self)
end

function update(self, dt)
	net.update(dt)
	if self.game then
		self.game:update(dt)
	end
	ui.update(self)
end

local TEXT = hash("text")
local MARKED_TEXT = hash("marked_text")
local BACKSPACE = hash("backspace")
local ENTER = hash("enter")
local TOUCH = hash("touch")

-- Typing into the name field
local function edit_input(self, action_id, action)
	if action_id == TEXT then
		local text = action.text:gsub("[%c]", "")
		if utf8_len(self.draft .. text) <= MAX_NAME_LENGTH then
			self.draft = self.draft .. text
		end
		self.marked = ""
	elseif action_id == MARKED_TEXT then
		self.marked = action.text or ""
	elseif action_id == BACKSPACE and (action.pressed or action.repeated) then
		self.draft = self.draft:gsub("[%z\1-\127\194-\244][\128-\191]*$", "")
	elseif action_id == ENTER and action.pressed then
		finish_editing(self)
		return true
	else
		return false
	end
	show_menu(self, self.message)
	return true
end

function on_input(self, action_id, action)
	if self.editing then
		if edit_input(self, action_id, action) then
			return true
		end
		-- Tapping anywhere outside the field finishes editing (and the tap still counts)
		if action_id == TOUCH and action.pressed and not gui.pick_node(self.name_field, action.x, action.y) then
			finish_editing(self)
		end
	end

	if action_id ~= TOUCH then
		return
	end
	if ui.on_input(self, action) then
		ui.raise_overlays(self)
		return true
	end
end

function final(self)
	gui.hide_keyboard()
	net.set_listener(nil)
	net.stop()
end
